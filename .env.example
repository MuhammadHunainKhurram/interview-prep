# Copy to .env and adjust. Everything here is bundled into the extension and is
# readable by anyone who has it installed: only put PUBLIC values here.
# Never put a Supabase service-role key or any other secret in this file.

# Where data is stored: "local" (chrome.storage, default) or "supabase" (not implemented yet).
WXT_STORAGE_BACKEND=local

# Only used when WXT_STORAGE_BACKEND=supabase. The anon key is public by design;
# access must be protected with row-level security policies.
WXT_SUPABASE_URL=
WXT_SUPABASE_ANON_KEY=
